<odoo>
    <record id="social_post_view_form_inherit_youtube" model="ir.ui.view">
        <field name="name">social.post.view.form.inherit.youtube</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social_media_base.social_post_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_ids']" position="after">
                <field name="has_youtube_account" invisible="1" />
                <field
                    name="youtube_privacy_status"
                    invisible="not has_youtube_account"
                />
            </xpath>
        </field>
    </record>
</odoo>
