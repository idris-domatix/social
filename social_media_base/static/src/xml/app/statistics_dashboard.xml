<templates xml:space="preserve">
    <t t-name="social_media_base.StatisticsDashboard">
        <div class="o_social_statistics">
            <div class="o_social_statistics_header">
                <div>
                    <h1>Statistics</h1>
                    <p class="o_social_statistics_subtitle">
                        How the accounts and their publications performed.
                    </p>
                </div>
                <div class="o_social_statistics_controls">
                    <div class="o_social_period" role="group" aria-label="Period">
                        <button
                            t-att-class="{'active': state.period === 7}"
                            t-on-click="() => this.setPeriod(7)"
                        >7 days</button>
                        <button
                            t-att-class="{'active': state.period === 30}"
                            t-on-click="() => this.setPeriod(30)"
                        >30 days</button>
                        <button
                            t-att-class="{'active': state.period === 90}"
                            t-on-click="() => this.setPeriod(90)"
                        >90 days</button>
                    </div>
                    <select
                        class="o_input o_social_account_filter"
                        t-on-change="setAccount"
                        aria-label="Account"
                    >
                        <option value="">All accounts</option>
                        <t t-foreach="accounts" t-as="account" t-key="account.id">
                            <option
                                t-att-value="account.id"
                                t-att-selected="state.accountId === account.id"
                                t-esc="account.name"
                            />
                        </t>
                    </select>
                    <button
                        class="btn btn-secondary"
                        t-on-click="openDetailed"
                    >Detailed view</button>
                </div>
            </div>
            <div t-if="state.loading" class="o_social_statistics_loading">
                Loading…
            </div>
            <div t-elif="state.error" class="o_social_statistics_error">
                <div class="alert alert-warning mb-0" role="alert">
                    <p class="mb-2" t-esc="state.error" />
                    <button
                        class="btn btn-secondary btn-sm"
                        t-on-click="retry"
                    >Retry</button>
                </div>
            </div>
            <t t-else="">
                <div class="o_social_kpis">
                    <div class="o_social_kpi">
                        <span class="o_social_kpi_label">Followers</span>
                        <strong t-esc="formatNumber(kpis.followers)" />
                    </div>
                    <div class="o_social_kpi">
                        <span class="o_social_kpi_label">Impressions</span>
                        <strong t-esc="formatNumber(kpis.impressions)" />
                    </div>
                    <div class="o_social_kpi">
                        <span class="o_social_kpi_label">Engagement</span>
                        <strong t-esc="formatPercent(kpis.engagement)" />
                    </div>
                    <div class="o_social_kpi">
                        <span class="o_social_kpi_label">Posts</span>
                        <strong t-esc="formatNumber(kpis.posts)" />
                    </div>
                </div>
                <div t-if="state.data.has_figures" class="o_social_charts">
                    <div
                        t-foreach="['impressions', 'engagement']"
                        t-as="chartKey"
                        t-key="chartKey"
                        class="o_social_chart_card"
                    >
                        <div class="o_social_card_header">
                            <h2 t-if="chartKey === 'impressions'">Impressions</h2>
                            <h2 t-else="">Engagement rate</h2>
                            <span class="o_social_card_hint">
                                <t t-if="chartKey === 'impressions'">Per day</t>
                                <t
                                    t-else=""
                                >(likes + comments + shares + clicks) / impressions</t>
                            </span>
                        </div>
                        <t t-set="chart" t-value="state.charts[chartKey]" />
                        <svg
                            t-if="chart"
                            t-attf-viewBox="0 0 {{ chart.width }} {{ chart.height }}"
                            class="o_social_chart"
                            role="img"
                            t-attf-aria-label="{{ chartKey }} per day"
                        >
                            <t t-foreach="chart.ticks" t-as="tick" t-key="tick.y">
                                <line
                                    t-att-x1="chart.pad"
                                    t-att-x2="chart.width - chart.pad"
                                    t-att-y1="tick.y"
                                    t-att-y2="tick.y"
                                    class="o_social_chart_grid"
                                />
                                <text
                                    t-att-x="6"
                                    t-att-y="tick.y + 4"
                                    class="o_social_chart_axis"
                                >
                                    <t t-esc="formatAxis(tick.value, chart.kind)" />
                                </text>
                            </t>
                            <path
                                t-att-d="chart.area"
                                t-attf-class="o_social_chart_area o_social_chart_area_{{ chartKey }}"
                            />
                            <polyline
                                t-att-points="chart.line"
                                t-attf-class="o_social_chart_line o_social_chart_line_{{ chartKey }}"
                            />
                            <t
                                t-foreach="chart.labels"
                                t-as="label"
                                t-key="label.index"
                            >
                                <text
                                    t-att-x="label.x"
                                    t-att-y="chart.height - 10"
                                    class="o_social_chart_axis"
                                    text-anchor="middle"
                                >
                                    <t t-esc="label.label" />
                                </text>
                            </t>
                        </svg>
                        <p t-else="" class="o_social_statistics_empty">
                            No figures for this period.
                        </p>
                    </div>
                </div>
                <div t-else="" class="o_social_statistics_empty_card">
                    <p class="mb-1">No statistics for this period yet.</p>
                    <p class="mb-3">
                        Publish a post or pick a longer period.
                    </p>
                    <button
                        t-if="state.period &lt; 90"
                        class="btn btn-secondary btn-sm"
                        t-on-click="() => this.setPeriod(90)"
                    >Show last 90 days</button>
                </div>
                <div class="o_social_statistics_grid">
                    <div class="o_social_top_posts">
                        <div class="o_social_card_header">
                            <h2>Top posts</h2>
                            <span class="o_social_card_hint">By impressions</span>
                        </div>
                        <table t-if="topPosts.length" class="o_social_top_posts_table">
                            <thead>
                                <tr>
                                    <th>Post</th>
                                    <th>Date</th>
                                    <th class="text-end">Likes</th>
                                    <th class="text-end">Comments</th>
                                    <th class="text-end">Impressions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="topPosts" t-as="post" t-key="post.id">
                                    <td>
                                        <div class="o_social_top_post">
                                            <img
                                                t-if="post.image_url"
                                                t-att-src="post.image_url"
                                                class="o_social_top_post_media"
                                                t-att-alt="post.message"
                                            />
                                            <div
                                                t-elif="post.media_type == 'tiktok' or post.media_type == 'youtube'"
                                                class="o_social_top_post_media o_social_top_post_video"
                                                aria-hidden="true"
                                            >
                                                <i class="fa fa-play" />
                                            </div>
                                            <div class="min-w-0">
                                                <a
                                                    t-if="post.post_account_url"
                                                    t-att-href="post.post_account_url"
                                                    target="_blank"
                                                    rel="noopener"
                                                    t-esc="post.message"
                                                />
                                                <span t-else="" t-esc="post.message" />
                                                <span
                                                    class="o_social_top_post_account"
                                                    t-esc="post.account_id[1]"
                                                />
                                            </div>
                                        </div>
                                    </td>
                                    <td t-esc="formatDate(post.published_date)" />
                                    <td
                                        class="text-end"
                                        t-esc="formatNumber(post.like_count)"
                                    />
                                    <td
                                        class="text-end"
                                        t-esc="formatNumber(post.comment_count)"
                                    />
                                    <td
                                        class="text-end"
                                        t-esc="formatNumber(post.impression_count)"
                                    />
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="o_social_statistics_empty">
                            No posts with figures for this period.
                        </p>
                    </div>
                    <div class="o_social_breakdown">
                        <div class="o_social_card_header">
                            <h2>Breakdown by account</h2>
                            <span class="o_social_card_hint">
                                Followers and impressions in the period
                            </span>
                        </div>
                        <table t-if="byAccount.length" class="o_social_top_posts_table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th class="text-end">Followers</th>
                                    <th class="text-end">Impressions</th>
                                    <th class="text-end">Engagement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="byAccount" t-as="row" t-key="row.id">
                                    <td>
                                        <div class="o_social_breakdown_account">
                                            <span class="o_social_breakdown_avatar">
                                                <img
                                                    t-attf-src="/web/image/social.account/{{ row.id }}/image_256"
                                                    t-att-alt="row.name"
                                                />
                                                <img
                                                    t-if="row.media_id"
                                                    t-attf-src="/web/image/social.media/{{ row.media_id }}/image"
                                                    class="o_social_breakdown_network"
                                                    t-att-alt="row.media_name"
                                                />
                                            </span>
                                            <span>
                                                <span t-esc="row.name" />
                                                <span
                                                    class="o_social_top_post_account"
                                                    t-esc="row.media_name"
                                                />
                                            </span>
                                        </div>
                                    </td>
                                    <td
                                        class="text-end"
                                        t-esc="formatNumber(row.followers)"
                                    />
                                    <td
                                        class="text-end"
                                        t-esc="formatNumber(row.impressions)"
                                    />
                                    <td
                                        class="text-end"
                                        t-esc="formatPercent(row.engagement)"
                                    />
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="o_social_statistics_empty">
                            No account reported figures for this period.
                        </p>
                    </div>
                </div>
                <p class="o_social_statistics_note">
                    Figures are collected by the scheduled checks and by the
                    Update button of each account.
                </p>
            </t>
        </div>
    </t>
</templates>
