<odoo>
    <record id="social_statistics_dashboard_action" model="ir.actions.client">
        <field name="name">Statistics</field>
        <field name="tag">social_statistics_dashboard</field>
    </record>

    <menuitem
        name="Social Media"
        id="social_root_menu"
        sequence="5"
        web_icon="social_media_base,static/description/icon.png"
        groups="social_media_base.group_social_media_user"
    >
        <menuitem
            name="Dashboard"
            id="social_dashboard_menu"
            action="social_post_account_action"
            sequence="1"
        />
        <menuitem
            name="Statistics"
            id="social_statistics_menu"
            action="social_statistics_dashboard_action"
            sequence="2"
        />
        <menuitem
            name="Posts"
            id="social_post_menu"
            sequence="3"
            action="social_post_action"
        />
        <menuitem name="Configuration" id="social_configuration_menu" sequence="100">
            <menuitem
                name="Accounts"
                id="social_account_menu"
                sequence="2"
                action="social_account_action"
            />
            <menuitem
                name="Social Media"
                id="social_media_menu"
                sequence="6"
                action="social_media_action"
            />
            <menuitem
                name="UTM Campaigns"
                id="utm_campaign_config_menu"
                sequence="10"
                action="utm.utm_campaign_action"
            />
        </menuitem>
    </menuitem>
</odoo>
